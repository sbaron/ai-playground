# /etc/nginx/sites-available/ai-playground - https://ai-playground.xyz/
# Cloudflare (proxied) sits in front. Certificate: Let's Encrypt via dns-cloudflare.

# http → https (one hop)
server {
    listen 80;
    listen [::]:80;
    server_name ai-playground.xyz www.ai-playground.xyz;

    return 301 https://ai-playground.xyz$request_uri;
}

# www → apex
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.ai-playground.xyz;

    ssl_certificate     /etc/letsencrypt/live/ai-playground.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai-playground.xyz/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    return 301 https://ai-playground.xyz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ai-playground.xyz;

    ssl_certificate     /etc/letsencrypt/live/ai-playground.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai-playground.xyz/privkey.pem;

    access_log /var/log/nginx/ai-playground.access.log;
    error_log  /var/log/nginx/ai-playground.error.log warn;

    root /var/www/ai-playground;
    index index.html;

    charset utf-8;
    charset_types text/plain text/css text/xml application/json application/javascript image/svg+xml;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/wasm application/xml image/svg+xml;

    # Server-level headers: no location below may use add_header (that would
    # drop them); caching uses `expires` instead. There is deliberately no
    # script/connect CSP: projects are arbitrary and may load CDNs or call APIs.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

    error_page 404 /404.html;
    location = /404.html {
        internal;
        expires -1;
    }

    # Always revalidate, so a deploy shows up at once (ETag / Last-Modified)
    location / {
        try_files $uri $uri/ =404;
        expires -1;
    }

    # Hidden files (.git, .env, ...), except ACME challenges
    location ~ /\.(?!well-known/) {
        deny all;
    }
}
